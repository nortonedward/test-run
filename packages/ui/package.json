{
  "name": "@cursor-run/ui",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/ui.umd.cjs",
  "module": "./dist/ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./tailwind.preset": {
      "types": "./tailwind.preset.ts",
      "import": "./tailwind.preset.ts",
      "default": "./tailwind.preset.ts"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ui.js",
      "require": "./dist/ui.umd.cjs"
    },
    "./styles": "./styles/tokens.css"
  },
  "files": [
    "dist",
    "styles",
    "tailwind.preset.ts"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "story:dev": "storybook dev -p 6006",
    "story:build": "storybook build",
    "story:preview": "npx serve storybook-static -l 6006"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@heroicons/vue": "^2.2.0",
    "@storybook/vue3-vite": "10.2.4",
    "@vitejs/plugin-vue": "^5.0.0",
    "storybook": "10.2.4",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vue": "^3.5.0",
    "eslint-plugin-storybook": "10.2.4",
    "@storybook/addon-docs": "10.2.4"
  }
}
