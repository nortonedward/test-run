{
  "UiAvatarUpload": {
    "props": [
      {
        "name": "modelValue",
        "type": "string",
        "default": "-",
        "description": "Current image URL or data URL (for v-model)."
      },
      {
        "name": "name",
        "type": "string",
        "default": "-",
        "description": "Display name for initials fallback."
      },
      {
        "name": "size",
        "type": "union",
        "default": "'md'",
        "description": "Size of the avatar (sm, md, lg)."
      },
      {
        "name": "maxSize",
        "type": "number",
        "default": "524288",
        "description": "Max file size in bytes (default: 512KB)."
      },
      {
        "name": "disabled",
        "type": "boolean",
        "default": "-",
        "description": "Disables interaction."
      },
      {
        "name": "class",
        "type": "string",
        "default": "-",
        "description": "Additional classes merged via cn()."
      }
    ]
  },
  "UiAvatar": {
    "props": [
      {
        "name": "src",
        "type": "string",
        "default": "-",
        "description": "Image URL. When absent, falls back to initials."
      },
      {
        "name": "alt",
        "type": "string",
        "default": "-",
        "description": "Alt text for the image."
      },
      {
        "name": "name",
        "type": "string",
        "default": "-",
        "description": "Display name — used to derive initials when src is absent (e.g. \"John Doe\" → \"JD\")."
      },
      {
        "name": "initials",
        "type": "string",
        "default": "-",
        "description": "Explicit initials when name is not suitable (e.g. \"JD\"). Overrides name-derived initials."
      },
      {
        "name": "size",
        "type": "union",
        "default": "'md'",
        "description": "Size of the avatar (sm, md, lg)."
      },
      {
        "name": "class",
        "type": "string",
        "default": "-",
        "description": "Additional classes merged via cn()."
      }
    ]
  },
  "UiAuthor": {
    "props": [
      {
        "name": "avatar",
        "type": "string",
        "default": "-",
        "description": "Avatar image URL. Falls back to initials from name when absent."
      },
      {
        "name": "name",
        "type": "string",
        "default": "-",
        "description": "Display name (e.g. username or \"John Doe\")."
      },
      {
        "name": "subtitle",
        "type": "string",
        "default": "-",
        "description": "Optional subtitle (e.g. timestamp, role)."
      },
      {
        "name": "size",
        "type": "union",
        "default": "'md'",
        "description": "Size of avatar and text scale (sm, md, lg)."
      },
      {
        "name": "class",
        "type": "string",
        "default": "-",
        "description": "Additional classes merged via cn()."
      }
    ]
  },
  "UiButton": {
    "props": [
      {
        "name": "variant",
        "type": "ButtonVariant",
        "default": "'primary'",
        "description": "Visual style; primary is main CTA, ghost is minimal."
      },
      {
        "name": "size",
        "type": "union",
        "default": "'md'",
        "description": "Size affects padding and text scale."
      },
      {
        "name": "type",
        "type": "union",
        "default": "'button'",
        "description": "Button type when rendered as native button."
      },
      {
        "name": "to",
        "type": "string",
        "default": "-",
        "description": "Internal link destination (used as href when no router)."
      },
      {
        "name": "href",
        "type": "string",
        "default": "-",
        "description": "External link destination."
      },
      {
        "name": "disabled",
        "type": "boolean",
        "default": "-",
        "description": "Disables interaction and reduces opacity."
      },
      {
        "name": "class",
        "type": "string",
        "default": "-",
        "description": "Additional classes merged via cn()."
      }
    ]
  },
  "UiIconButton": {
    "props": [
      {
        "name": "icon",
        "type": "Component",
