    "props": [
      {
        "name": "level",
        "type": "union",
        "default": "1",
        "description": "Heading level 1–6."
      },
      {
        "name": "muted",
        "type": "string",
        "default": "-",
        "description": "Optional muted subtext shown below the heading."
      },
      {
        "name": "class",
        "type": "string",
        "default": "-",
        "description": ""
      }
    ]
  },
  "UiLink": {
    "props": [
      {
        "name": "to",
