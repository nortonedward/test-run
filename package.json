{
  "name": "cursor-run",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "build:ui": "pnpm --filter @cursor-run/ui build",
    "build:landing": "pnpm --filter landing build",
    "dev": "concurrently -n ui,landing -c blue,green \"pnpm --filter @cursor-run/ui dev\" \"pnpm --filter landing dev\"",
    "dev:landing": "pnpm --filter landing dev",
    "dev:ui": "pnpm --filter @cursor-run/ui dev",
    "story:dev": "pnpm --filter @cursor-run/ui story:dev",
    "docs:gen": "node scripts/generate-docgen.mjs",
    "docs:dev": "pnpm docs:gen && vitepress dev docs",
    "dev:docs": "pnpm docs:gen && concurrently -n docs,story -c blue,green \"vitepress dev docs\" \"pnpm story:dev\"",
    "docs:build": "pnpm docs:gen && vitepress build docs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@cursor-run/ui": "workspace:*",
    "@nuxt/module-builder": "^1.0.2",
    "concurrently": "^9.1.2",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "vitepress": "^1.6.4",
    "vue-docgen-api": "^4.79.2"
  }
}
